# Runtime
NODE_ENV=development
APP_ENV=local
PORT=3000
SERVICE_ID=beauty-management-api
SERVICE_VERSION=local
AUTH_PROVIDER=mock
# JWT remoto: configurar valores reais; mocks somente local/test.
# AUTH_PROVIDER=jwt
# AUTH_ISSUER=
# AUTH_AUDIENCE=
# AUTH_JWKS_URL=
# AUTH_ALGORITHM=

# Database
DATABASE_URL=postgresql://beauty:beauty_local_password@localhost:5432/beauty_management

# Observability
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_ENDPOINT=https://observe-api.nestjs.com
OBSERVE_TRACE_SAMPLE_RATE=1
OBSERVE_DEBUG=false
OBSERVE_FORWARD_LOGS=true
OBSERVE_RUNTIME_METRICS=true
OBSERVE_RUNTIME_METRICS_INTERVAL=60000
OBSERVE_MAX_TRACES_PER_BATCH=1000
OBSERVE_FLUSH_INTERVAL=5000

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/beauty-management-api/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "apps/beauty-management-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/beauty-management-api",
  "projects": {
    "beauty-management-api": {
      "type": "application",
      "root": "apps/beauty-management-api",
      "entryFile": "main",
      "sourceRoot": "apps/beauty-management-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/beauty-management-api/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "billing-worker": {
      "type": "application",
      "root": "apps/billing-worker",
      "entryFile": "main",
      "sourceRoot": "apps/billing-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/billing-worker/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "clinical-worker": {
      "type": "application",
      "root": "apps/clinical-worker",
      "entryFile": "main",
      "sourceRoot": "apps/clinical-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/clinical-worker/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "operations-worker": {
      "type": "application",
      "root": "apps/operations-worker",
      "entryFile": "main",
      "sourceRoot": "apps/operations-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/operations-worker/tsconfig.app.json",
        "deleteOutDir": false
      }
    }
  }
}

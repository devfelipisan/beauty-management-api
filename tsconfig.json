{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@beauty/kernel": ["libs/kernel/src/index.ts"],
      "@beauty/kernel/*": ["libs/kernel/src/*"],
      "@beauty/contracts": ["libs/contracts/src/index.ts"],
      "@beauty/contracts/*": ["libs/contracts/src/*"],
      "@beauty/config": ["libs/config/src/index.ts"],
      "@beauty/config/*": ["libs/config/src/*"],
      "@beauty/testing": ["libs/testing/src/index.ts"],
      "@beauty/testing/*": ["libs/testing/src/*"],
      "@beauty/execution-context": ["libs/execution-context/src/index.ts"],
      "@beauty/execution-context/*": ["libs/execution-context/src/*"],
      "@beauty/observability": ["libs/observability/src/index.ts"],
      "@beauty/observability/*": ["libs/observability/src/*"]
    },
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"]
  }
}

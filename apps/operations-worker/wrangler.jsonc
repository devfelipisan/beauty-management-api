{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "beauty-operations-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "d1_databases": [{
    "binding": "D1_DATABASE",
    "database_name": "beauty-operations-local",
    "migrations_dir": "../../database/d1/migrations"
  }],
  "services": [
    { "binding": "CLINICAL_SERVICE", "service": "beauty-clinical-worker" },
    { "binding": "BILLING_SERVICE", "service": "beauty-billing-worker" }
  ]
}

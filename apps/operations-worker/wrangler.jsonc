{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "beauty-operations-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "d1_databases": [
    {
      "binding": "D1_DATABASE",
      "database_name": "beauty_db",
      "database_id": "18b04b90-845a-400e-a0f4-eeb3a04b8188",
      "migrations_dir": "../../database/d1/migrations",
    },
  ],
  "services": [
    {
      "binding": "CLINICAL_SERVICE",
      "service": "beauty-clinical-worker",
      "props": {
        "caller": "beauty-operations-worker",
      },
    },
    {
      "binding": "BILLING_SERVICE",
      "service": "beauty-billing-worker",
      "props": {
        "caller": "beauty-operations-worker",
      },
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "secrets": {
    "required": [
      "AUTH_ISSUER",
      "AUTH_AUDIENCE",
      "AUTH_JWKS_URL",
      "AUTH_ALGORITHM",
    ],
  },
  "vars": {},
  "observability": {
    "enabled": true,
  },
  "env": {
    "local": {
      "name": "beauty-operations-worker",
      "secrets": {
        "required": [],
      },
      "vars": {
        "APP_ENV": "local",
        "AUTH_PROVIDER": "mock",
        "OBSERVE_ENABLED": "false",
        "MAX_PROFILE_IMAGE_BYTES": "300000",
      },
      "d1_databases": [
        {
          "binding": "D1_DATABASE",
          "database_name": "beauty_db",
          "migrations_dir": "../../database/d1/migrations",
        },
      ],
      "services": [
        {
          "binding": "CLINICAL_SERVICE",
          "service": "beauty-clinical-worker",
          "props": {
            "caller": "beauty-operations-worker",
          },
        },
        {
          "binding": "BILLING_SERVICE",
          "service": "beauty-billing-worker",
          "props": {
            "caller": "beauty-operations-worker",
          },
        },
      ],
      "define": {
        "__BEAUTY_LOCAL__": "true",
      },
      "r2_buckets": [
        {
          "binding": "PROFILE_MEDIA",
          "bucket_name": "beauty-r2",
        },
      ],
      "triggers": {
        "crons": [],
      },
    },
  },
  "keep_vars": true,
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "__BEAUTY_LOCAL__": "false",
  },
  "r2_buckets": [
    {
      "binding": "PROFILE_MEDIA",
      "bucket_name": "beauty-r2",
    },
  ],
  "triggers": {
    "crons": ["*/1 * * * *"],
  },
}

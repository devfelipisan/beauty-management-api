{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beauty-clinical-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "d1_databases": [{
    "binding": "D1_DATABASE",
    "database_name": "beauty-operations-local",
    "migrations_dir": "../../database/d1/migrations"
  }],
  "services": [{ "binding": "OPERATIONS_SERVICE", "service": "beauty-operations-worker" }, { "binding": "BILLING_SERVICE", "service": "beauty-billing-worker" }],
  "r2_buckets": [{ "binding": "SESSION_MEDIA", "bucket_name": "beauty-session-media" }]
}

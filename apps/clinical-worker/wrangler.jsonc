{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "beauty-clinical-worker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "d1_databases": [
    {
      "binding": "D1_DATABASE",
      "database_name": "beauty_db",
      "migrations_dir": "../../database/d1/migrations"
    }
  ],
  "services": [
    {
      "binding": "OPERATIONS_SERVICE",
      "service": "beauty-operations-worker",
      "props": {
        "caller": "beauty-clinical-worker"
      }
    },
    {
      "binding": "BILLING_SERVICE",
      "service": "beauty-billing-worker",
      "props": {
        "caller": "beauty-clinical-worker"
      }
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production",
    "AUTH_PROVIDER": "jwt",
    "OBSERVE_ENABLED": "true"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "local": {
      "name": "beauty-clinical-worker",
      "vars": {
        "APP_ENV": "local",
        "AUTH_PROVIDER": "mock",
        "OBSERVE_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "D1_DATABASE",
          "database_name": "beauty_db",
          "migrations_dir": "../../database/d1/migrations"
        }
      ],
      "services": [
        {
          "binding": "OPERATIONS_SERVICE",
          "service": "beauty-operations-worker",
          "props": {
            "caller": "beauty-clinical-worker"
          }
        },
        {
          "binding": "BILLING_SERVICE",
          "service": "beauty-billing-worker",
          "props": {
            "caller": "beauty-clinical-worker"
          }
        }
      ]
    }
  }
}

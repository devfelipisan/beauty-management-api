  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ],
  "references": [

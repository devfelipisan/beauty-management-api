{
  "name": "beauty-management-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run typecheck",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:foundation": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/foundation-backend.test.ts",
    "test:state-machines": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/state-machines.test.ts",
    "test:security": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/security-contracts.test.ts",
    "test:leads": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/leads-domain.test.ts",
    "test:equipment": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/equipment-domain.test.ts",
    "test:repositories": "node --experimental-transform-types --experimental-loader ./scripts/ts-alias-loader.mjs --test src/testing/repository-contracts.test.ts",
    "test": "npm run test:foundation && npm run test:state-machines && npm run test:security && npm run test:leads && npm run test:equipment && npm run test:repositories",
    "check": "npm run typecheck && npm run test",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts"
  },
  "dependencies": {
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.4",
    "wrangler": "^4.119.0"
  }
}

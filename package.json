{
  "name": "beauty-management-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/beauty-management-api/src/main.js",
    "start:operations": "nest start operations-worker",
    "start:billing": "nest start billing-worker",
    "start:clinical": "nest start clinical-worker",
    "dev:workers": "wrangler dev -c apps/operations-worker/wrangler.jsonc -c apps/clinical-worker/wrangler.jsonc -c apps/billing-worker/wrangler.jsonc",
    "lint": "oxlint apps/ libs/",
    "test": "vitest run --config ./vitest.config.ts",
    "test:unit": "vitest run --config ./vitest.config.ts",
    "test:workers": "vitest run --config ./vitest.config.workers.mjs",
    "typecheck": "tsc --build --force",
    "workers:dry-run": "node scripts/workers-dry-run.mjs",
    "gate:physical-safety": "npm run lint && npm run typecheck && npm run test:unit && npm run test:workers && npm run workers:dry-run",
    "test:watch": "vitest --config ./vitest.config.ts",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:up": "docker compose --env-file docker/.env -f docker/compose.yaml up -d",
    "db:down": "docker compose --env-file docker/.env -f docker/compose.yaml down",
    "db:status": "docker compose --env-file docker/.env -f docker/compose.yaml ps",
    "db:logs": "docker compose --env-file docker/.env -f docker/compose.yaml logs -f postgres",
    "db:psql": "docker compose --env-file docker/.env -f docker/compose.yaml exec postgres psql -U beauty -d beauty_management",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "joi": "^18.2.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rolldown/binding-wasm32-wasi": "^1.2.6",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "wrangler": "^4.127.1"
  }
}

# Authentication is not part of the current MVP stage.
# false (default): tenant-scoped API works without Bearer token.
# true: Supabase Auth + membership/RBAC are required.
AUTHENTICATION_ENABLED=false

# Runtime persistence source.
# postgres (default): real Supabase/PostgreSQL runtime.
# memory: disables PostgreSQL completely and loads a deterministic demo dataset for UI/page testing.
API_DATA_SOURCE=postgres

# When API_DATA_SOURCE=memory, DATABASE_URL and the decomposed runtime database variables are not required.
# The fallback workspace is Bella Estética Demo and the API stays fully in-process for supported MVP flows.

# Worker runtime database connection used only when API_DATA_SOURCE=postgres.
# Preferred: copy the exact Transaction Pooler URI from Supabase > Connect.
# DATABASE_URL is sufficient by itself for runtime PostgreSQL access.
DATABASE_URL=

# Optional alternative when DATABASE_URL is not used.
# No hostname is inferred from region; use the exact pooler endpoint.
# SBDatabaseHost=
# SBDatabasePort=6543
# SBDatabaseUser=postgres.zkzzptgbiwsxinzmfvss
# SBNameDB=postgres
# SPPasswordDB=

# Migration/seed tooling is separate from the Worker runtime.
# Preferred: direct PostgreSQL connection string used only by scripts/database.mjs.
MIGRATION_DATABASE_URL=

# Optional decomposed migration configuration when MIGRATION_DATABASE_URL is not used.
# SPIdBD=zkzzptgbiwsxinzmfvss
# SBNameDB=postgres
# SPPasswordDB=
# SBMigrationHost=db.zkzzptgbiwsxinzmfvss.supabase.co
# SBMigrationPort=5432
# SBMigrationUser=postgres

# Supabase Auth only. Required only when AUTHENTICATION_ENABLED=true.
# SPIdBD=zkzzptgbiwsxinzmfvss
# ApiKeySupaBase=

# Authentication is not part of the current MVP stage.
# false (default): tenant-scoped API works without Bearer token, but tenant is still resolved in PostgreSQL.
# true: Supabase Auth + membership/RBAC are required.
AUTHENTICATION_ENABLED=false

# Supabase project/database configuration
SPIdBD=zkzzptgbiwsxinzmfvss
SBNameDB=postgres

# Preferred Worker runtime connection: copy the Transaction Pooler URI from Supabase > Connect.
# Keep the password percent-encoded when embedding it directly in this URI.
DATABASE_URL=

# Alternative decomposed pooler configuration when DATABASE_URL is not used.
SBDatabaseHost=
SBDatabasePort=6543
SBDatabaseUser=postgres.zkzzptgbiwsxinzmfvss
SPRegionDB=

# Direct migration connection. Defaults to db.<SPIdBD>.supabase.co:5432 / user postgres.
# MIGRATION_DATABASE_URL=
# SBMigrationHost=db.zkzzptgbiwsxinzmfvss.supabase.co
# SBMigrationPort=5432
# SBMigrationUser=postgres

# Secrets - never commit real values.
SPPasswordDB=
# Required only when AUTHENTICATION_ENABLED=true.
ApiKeySupaBase=

# Optional local migration tooling mode:
# SPDatabaseConnectionMode=runtime

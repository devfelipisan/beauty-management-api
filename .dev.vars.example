# Supabase project/database configuration
# SPRegionDB is the Supabase/AWS region used by the shared Supavisor pooler, e.g. sa-east-1.
SPRegionDB=
# Supabase project reference/id. Example derived from db.<project-ref>.supabase.co.
SPIdBD=zkzzptgbiwsxinzmfvss
# Database name; Supabase default is postgres.
SBNameDB=postgres

# Secrets - never commit real values.
# PostgreSQL database password. An API key cannot replace this credential.
SPPasswordDB=
# Supabase publishable/anon API key used only for Auth token verification.
ApiKeySupaBase=

# Optional for local migration tooling only:
# direct (default) uses db.<project-ref>.supabase.co:5432.
# runtime uses aws-<region>.pooler.supabase.com:6543 when direct IPv6 is unavailable locally.
# SPDatabaseConnectionMode=runtime
